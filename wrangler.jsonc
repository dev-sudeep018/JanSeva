{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "janseva",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-30",
  "upload_source_maps": true,
  "assets": {
    "directory": "./janseva-premium",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "janseva-production",
      "database_id": "c80aef4d-01d2-4d4c-aac5-bc86de7dd778",
      "migrations_dir": "./migrations",
    },
  ],
  "secrets": {
    "required": ["ADMIN_PASSWORD", "SESSION_SECRET", "RATE_LIMIT_SALT"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
}
